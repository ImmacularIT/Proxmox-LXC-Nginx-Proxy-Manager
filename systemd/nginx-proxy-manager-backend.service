[Unit]
Description=Nginx Proxy Manager backend API
Documentation=https://github.com/NginxProxyManager/nginx-proxy-manager
Wants=network-online.target
After=network-online.target
Before=nginx-proxy-manager-nginx.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=npm
Group=npm
WorkingDirectory=/opt/nginx-proxy-manager/current
EnvironmentFile=/etc/nginx-proxy-manager/environment
ExecStartPre=+/usr/local/sbin/npm-lxc-prepare
ExecStart=/usr/bin/node --abort_on_uncaught_exception --max_old_space_size=250 index.js
Restart=on-failure
RestartSec=2s
TimeoutStartSec=180s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027
# Upstream NPM's certificate workflow invokes `nginx -t` from the backend
# process before launching Certbot. OpenResty validates low-port listeners while
# testing the generated ACME config, so the unprivileged backend needs only the
# bind-service capability for that child process. Keep the capability set
# otherwise empty and retain NoNewPrivileges/systemd filesystem hardening.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
# The backend invokes nginx -t/-s during certificate workflows. Because
# PrivateTmp gives the backend its own /tmp namespace, bind the same
# service-owned backing directory used by the OpenResty unit onto the official
# /tmp/nginx path so ACME validation can create /tmp/nginx/body.
CacheDirectory=nginx/tmp
CacheDirectoryMode=0750
BindPaths=/var/cache/nginx/tmp:/tmp/nginx
RuntimeDirectory=nginx
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/data /etc/letsencrypt /etc/nginx/conf.d /etc/nginx-proxy-manager /run/nginx /var/backups/nginx-proxy-manager /var/lib/nginx /var/lib/logrotate /var/cache/nginx /var/log/nginx /opt/certbot

[Install]
WantedBy=multi-user.target
